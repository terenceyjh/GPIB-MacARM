include LICENSE THIRD_PARTY.md UPSTREAM.json README.md README.zh-CN.md CLAUDE.md CHANGELOG.md .gitattributes
recursive-include native *.cpp *.h
recursive-include vendor *.c *.cpp *.h README AUTHORS COPYING *.patch
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py *.c
recursive-include tools *.py *.sh
global-exclude *.so *.dylib *.dll *.pyd *.o *.pyc
prune build
prune dist
prune artifacts
